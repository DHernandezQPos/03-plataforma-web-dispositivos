{
  "Api": {
    "BaseUrl": "https://localhost:7279/"
  },
  "Authentication": {
    "Oidc": {
      "Authority": "https://identity.example.com",
      "ClientId": "c2c-device-platform-web",
      "ClientSecret": "<set-in-secret-store>",
      "ApiScope": "api://<platform-api-app-id>/access_as_user"
    }
  },
  "Authorization": {
    "AllowMissingEnvironmentClaim": false,
    "DefaultEnvironment": "demo"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
